---
import BaseLayout from '../layouts/BaseLayout.astro';
import cincoEstrelasImage from '../images/cinco_estrelas.jpg';
import felipeImage from '../images/felipe_campos.jpg';
import fuhaiImage from '../images/fuhai.gif';
import madMazeImage from '../images/mad_maze.png';
import neurobasketballImage from '../images/neurobasketball.webp';

interface Props { locale: 'en' | 'pt'; }
const { locale } = Astro.props;
const isPt = locale === 'pt';
const base = import.meta.env.BASE_URL;
const copy = isPt ? {
	nav: ['Sobre', 'Experiência', 'Projetos', 'Formação'], role: 'Game Developer · Produção · Liderança', kicker: 'Portfolio selecionado · 2026', headline: 'Construo jogos e equipes que chegam mais longe.', intro: 'Desenvolvedor Unity com experiência em produção, QA e direção de arte. Transformo ideias ambiciosas em projetos jogáveis, organizados e prontos para serem apresentados.', projects: 'Ver projetos', download: 'Baixar currículo', about: 'Uma visão ampla, com foco no que importa', aboutText: 'Assumi responsabilidades de liderança em quatro projetos — Mad Maze, Codename Fuhai, Five Stars e Neurobasketball — conectando escopo, pessoas, código e direção visual para levar cada ideia adiante. Essa experiência se apoia em uma base ampla de software, com conhecimento de programação, QA, ferramentas, arte e produção, especialmente aplicado ao desenvolvimento de jogos. Hoje, no Insert Koin Studio, continuo esse trabalho como project manager, studio head e programador.', experience: 'Experiência', experienceSub: 'Produto, qualidade e desenvolvimento em diferentes contextos.', projectsTitle: 'Projetos em destaque', projectsSub: 'Onde liderança, técnica e intenção visual se encontram.', education: 'Formação', contact: 'Vamos criar algo marcante.', contactSub: 'Aberto a oportunidades em produção, desenvolvimento e QA para jogos.', mail: 'Entrar em contato', skills: 'Ferramentas que uso para dar forma às ideias', language: 'EN',
} : {
	nav: ['About', 'Experience', 'Projects', 'Education'], role: 'Game Developer · Production · Leadership', kicker: 'Selected portfolio · 2026', headline: 'I build games and teams that go further.', intro: 'Unity developer with experience across production, QA, and art direction. I turn ambitious ideas into playable, organized projects ready to be shared.', projects: 'View projects', download: 'Download resume', about: 'A wide perspective, focused on what matters', aboutText: 'I have taken leadership responsibility across four projects — Mad Maze, Codename Fuhai, Five Stars, and Neurobasketball — connecting scope, people, code, and visual direction to move each idea forward. That experience is grounded in broad software knowledge across programming, QA, tools, art, and production, with a particular focus on game development. Today, at Insert Koin Studio, I continue that work as project manager, studio head, and programmer.', experience: 'Experience', experienceSub: 'Product, quality, and development across different contexts.', projectsTitle: 'Selected projects', projectsSub: 'Where leadership, craft, and visual intent meet.', education: 'Education', contact: "Let's make something memorable.", contactSub: 'Open to opportunities in game production, development, and QA.', mail: 'Get in touch', skills: 'The tools I use to shape ideas', language: 'PT',
};

const experiences = isPt ? [
	{ period: '2026 — presente', role: 'Project Manager · Studio Head · UI & Animation Programmer', company: 'Insert Koin Studio', text: 'Trabalho com amigos da faculdade para finalizar Mad Maze, liderando a produção do estúdio e programando suas interfaces e sistemas de animação.' },
	{ period: '2026', role: 'QA Analyst', company: 'AIMANA', text: 'Testes e validação de soluções com IA, RPA, assistentes virtuais e sistemas de SalesOps. Criação de ferramenta interna com ClickUp e GitHub, economizando mais de 4 horas por semana.' },
	{ period: '2025 — 2026', role: 'Desenvolvedor IA / Python', company: 'AIMANA', text: 'Soluções de chatbot e automação em Python com LangChain e OpenAI para clientes de saúde e vendas B2B.' },
	{ period: '2024', role: 'Agente de Sucesso do Aluno', company: 'Projeto Desenvolve', text: 'Ferramentas internas em React para feedback de alunos. Professor e tutor de JavaScript, Python e lógica de programação.' },
] : [
	{ period: '2026 — present', role: 'Project Manager · Studio Head · UI & Animation Programmer', company: 'Insert Koin Studio', text: 'Working with college friends to finish Mad Maze, leading the studio production and programming its interfaces and animation systems.' },
	{ period: '2026', role: 'QA Analyst', company: 'AIMANA', text: 'Test and validate AI, RPA, virtual assistant, SalesOps, and fleet management solutions. Built an internal ClickUp + GitHub tool that saves 4+ hours per week.' },
	{ period: '2025 — 2026', role: 'AI / Python Developer', company: 'AIMANA', text: 'Built chatbot and automation solutions in Python with LangChain and OpenAI for healthcare and B2B sales clients.' },
	{ period: '2024', role: 'Student Success Agent', company: 'Projeto Desenvolve', text: 'Created internal React tools for student feedback. Taught and mentored beginners in JavaScript, Python, and programming logic.' },
];

const projects = [
	{ featured: true, image: madMazeImage, index: '01', title: 'Mad Maze', tag: isPt ? 'Insert Koin Studio · Liderança · Unity' : 'Insert Koin Studio · Leadership · Unity', text: isPt ? 'Jogo cooperativo de terror criado por uma equipe multidisciplinar de 11 artistas e programadores. No estúdio, atuo como project manager, studio head, UI programmer e animation programmer.' : 'A co-op horror game created by a multidisciplinary team of 11 artists and programmers. At the studio, I work as project manager, studio head, UI programmer, and animation programmer.', meta: isPt ? ['Project management', 'Studio head', 'UI programming', 'Animation programming'] : ['Project management', 'Studio head', 'UI programming', 'Animation programming'], outcome: isPt ? 'Apresentado no Minas Summit 2026 e showcase da PUC Minas · TCC nota 97/100' : 'Presented at Minas Summit 2026 and PUC Minas showcase · Thesis grade 97/100' },
	{ featured: false, image: fuhaiImage, index: '02', title: 'Codename Fuhai', tag: 'Unity · Gameplay', text: isPt ? 'Sistemas de combate e física em C#, arte conceitual, modelagem 3D e direção do ambiente final.' : 'Combat and physics systems in C#, concept art, 3D modeling, and final-level environment art.', meta: ['C#', 'Physics', 'Blender'] },
	{ featured: false, image: cincoEstrelasImage, index: '03', title: 'Five Stars', tag: 'Unity · Systems', text: isPt ? 'Controles do jogador e mecânicas centrais de simulação para um projeto acadêmico.' : 'Player controls and core simulation mechanics for an academic game project.', meta: ['Gameplay', 'C#', 'Simulation'] },
	{ featured: false, image: neurobasketballImage, fit: 'contain', index: '04', title: 'Neurobasketball', tag: isPt ? 'Projeto pessoal · Mobile' : 'Personal project · Mobile', text: isPt ? 'Aplicativo Android para performance de atletas, da arquitetura aos protótipos de UI.' : 'An Android app for athlete performance, from architecture to UI prototypes.', meta: ['Android', 'Figma', 'Product'] },
];

const skillGroups = [
	['Game engines', 'Unity', 'Unreal Engine 5', 'URP', 'Blueprints'], ['Programming', 'C#', 'Python', 'TypeScript', 'SQL', 'JavaScript'], ['Multiplayer & UI', 'Mirror', 'MetaVoiceChat', 'TextMeshPro'], ['Art & tech art', 'Blender', 'Figma', 'Krita', 'Photoshop'], ['QA & production', 'Test planning', 'Bug reporting', 'Git', 'Scrum', 'Trello'],
];
---

<BaseLayout locale={locale} title="Felipe Campos · Game Developer" description={copy.intro}>
	<div class="site-shell">
		<div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
		<header class="topbar"><a class="brand" href={`/${locale === 'pt' ? 'pt/' : ''}`} aria-label="Felipe Campos home"><span>FC</span><strong>Felipe Campos</strong></a><nav data-nav>{copy.nav.map((item, index) => <a class="section-link" href={`#${['about', 'experience', 'projects', 'education'][index]}`}><span class="nav-icon" aria-hidden="true">{index === 0 && <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.25" /><path d="M5.5 19c.8-3 3-4.5 6.5-4.5s5.7 1.5 6.5 4.5" /></svg>}{index === 1 && <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2" /><path d="M8 5V3.5h8V5M8 10h8M8 14h5" /></svg>}{index === 2 && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" /></svg>}{index === 3 && <svg viewBox="0 0 24 24"><path d="M6 4.5h9l3 3V19.5H6z" /><path d="M15 4.5v3h3M9 12h6M9 15h6" /></svg>}</span><span>{item}</span></a>)}<a class="language" href={locale === 'en' ? `${base}pt/` : base} aria-label={`Switch language to ${copy.language}`}><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M4.5 12h15M12 4c2 2.2 3 4.9 3 8s-1 5.8-3 8c-2-2.2-3-4.9-3-8s1-5.8 3-8z" /></svg></span><span>{copy.language}</span></a></nav></header>
		<nav data-mobile-nav aria-label="Mobile section navigation">{copy.nav.map((item, index) => <a class="section-link" href={`#${['about', 'experience', 'projects', 'education'][index]}`}><span class="nav-icon" aria-hidden="true">{index === 0 && <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.25" /><path d="M5.5 19c.8-3 3-4.5 6.5-4.5s5.7 1.5 6.5 4.5" /></svg>}{index === 1 && <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2" /><path d="M8 5V3.5h8V5M8 10h8M8 14h5" /></svg>}{index === 2 && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" /></svg>}{index === 3 && <svg viewBox="0 0 24 24"><path d="M6 4.5h9l3 3V19.5H6z" /><path d="M15 4.5v3h3M9 12h6M9 15h6" /></svg>}</span><span>{item}</span></a>)}<a class="language" href={locale === 'en' ? `${base}pt/` : base} aria-label={`Switch language to ${copy.language}`}><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M4.5 12h15M12 4c2 2.2 3 4.9 3 8s-1 5.8-3 8c-2-2.2-3-4.9-3-8s1-5.8 3-8z" /></svg></span><span>{copy.language}</span></a></nav>
		<main>
			<section class="hero section-wrap"><div class="hero-copy" data-reveal><p class="eyebrow"><span class="status-dot"></span>{copy.kicker}</p><h1>{copy.headline}</h1><p class="hero-intro">{copy.intro}</p><div class="hero-actions"><a class="button button-primary" href="#projects">{copy.projects} <span>↘</span></a><a class="button button-quiet" href={`${base}resume-felipe-campos.pdf`}>{copy.download} <span>↓</span></a></div><div class="social-row"><a href="https://linkedin.com/in/felipecamposap" target="_blank">LinkedIn ↗</a><a href="https://github.com/felipecamposap" target="_blank">GitHub ↗</a><a href="mailto:felipecamposap@gmail.com">felipecamposap@gmail.com</a></div></div></section>
			<section class="stats section-wrap" data-reveal><div><strong>4</strong><span>{isPt ? 'projetos gerenciados' : 'projects managed'}</span></div><div><strong>5</strong><span>{isPt ? 'jogos acadêmicos' : 'academic games'}</span></div><div><strong>7<span>+ years</span></strong><span>{isPt ? 'experiência com C#' : 'C# experience'}</span></div><div><strong>5<span>+ years</span></strong><span>Unity development</span></div></section>
			<section id="about" class="split-section section-wrap"><div class="section-label">01 / {copy.nav[0]}</div><div class="section-content" data-reveal><h2>{copy.about}</h2><div class="about-layout"><div><p class="large-copy">{copy.aboutText}</p></div><div class="about-profile"><img src={felipeImage.src} alt="Felipe Campos" /><span>Game developer<br />& project lead</span></div></div></div></section>
			<section class="skills-section section-wrap"><div class="section-label">02 / Skills</div><div class="section-content" data-reveal><h2>{copy.skills}</h2><div class="skill-grid">{skillGroups.map((group) => <div class="skill-group"><h3>{group[0]}</h3><div class="chips">{group.slice(1).map((skill) => <span>{skill}</span>)}</div></div>)}</div></div></section>
			<section id="experience" class="split-section section-wrap"><div class="section-label">03 / {copy.experience}</div><div class="section-content" data-reveal><h2>{copy.experienceSub}</h2><div class="timeline">{experiences.map((item) => <article class="timeline-item"><span class="timeline-period">{item.period}</span><div><h3>{item.role} <small>{item.company}</small></h3><p>{item.text}</p></div></article>)}</div></div></section>
			<section id="projects" class="projects-section section-wrap"><div class="section-label">04 / {copy.projectsTitle}</div><div class="section-content" data-reveal><h2>{copy.projectsSub}</h2><div class="project-grid">{projects.map((project) => <article class:list={['project-card', { featured: project.featured }]}><div class:list={['project-visual', { 'contain-image': project.fit === 'contain' }]}><span>{project.index}</span>{project.image ? <img src={project.image.src} alt={`${project.title} project artwork`} /> : <div class="project-glyph">{project.title.slice(0, 2).toUpperCase()}</div>}</div><div class="project-info"><p class="project-tag">{project.tag}</p><h3>{project.title}</h3><p>{project.text}</p><div class="project-meta">{project.meta.map((item) => <span>{item}</span>)}</div>{project.outcome && <strong class="outcome">{project.outcome}</strong>}</div></article>)}</div></div></section>
			<section id="education" class="split-section section-wrap"><div class="section-label">05 / {copy.education}</div><div class="section-content" data-reveal><div class="education-list"><article><span>2026 — 2028</span><div><h3>MBA · Agile Project Management</h3><p>PUC Minas · {isPt ? 'em andamento' : 'in progress'}</p></div></article><article><span>2021 — 2026</span><div><h3>B.S. · Digital Games Design</h3><p>PUC Minas University</p></div></article><article><span>2017 — 2019</span><div><h3>Technical High School · IT</h3><p>COTEMIG</p></div></article></div></div></section>
			<section class="contact-section section-wrap" data-reveal><p class="eyebrow">06 / Contact</p><h2>{copy.contact}</h2><p>{copy.contactSub}</p><a class="button button-primary" href="mailto:felipecamposap@gmail.com">{copy.mail} <span>↗</span></a></section>
		</main><footer><span>© 2026 Felipe Campos</span><span>Built with Astro · Belo Horizonte, BR</span><a href="#top">Back to top ↑</a></footer>
	</div>
</BaseLayout>